Package: roscar
Type: Package
Title: Calibrated External Predictions for Trial Treatment Effects
Version: 0.1.0.9000
Authors@R: c(
    person("Amir", "Asiaeetaheri", role = c("aut", "cre"),
           email = "amir.asiaeetaheri@vumc.org"),
